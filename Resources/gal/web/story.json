,"actions":[{"set_var":"affection += 4"}]},{"text":"假装没听见","actions":[{"set_var":"affection -= 1"}]}]},{"type":"dialogue","character":"xii","emotion":"smile","text":"这首我循环了一整个下午。"},{"type":"present_pic","path":""},{"type":"hide_character","character":"xii"},{"type":"chapter_end","mode":"branching","options":[{"condition":"affection >= 7","next":"ending/true"},{"default":true,"next":"ending/normal"}]}],"route/b":[{"type":"music","path":"湿掉的鞋"},{"type":"narration","text":"她哼了一声，把伞往你那边偏了偏，自己半边肩膀露在雨里。"},{"type":"show_character","character":"xii","position":"right","emotion":"pout"},{"type":"dialogue","character":"xii","text":"猜？我要是猜得出来，还用在这儿等三分十七秒？"},{"type":"choices","prompt":"她抬眼看你。","options":[{"text":"那我下次早点","actions":[{"set_var":"affection += 2"}]},{"text":"你不是挺喜欢等的吗","actions":[{"set_var":"affection -= 2"}]}]},{"type":"dialogue","character":"xii","emotion":"calm","text":"……吃饭。"},{"type":"narration","text":"她把饭盒塞进你手里，力道比平时重一点。"},{"type":"chapter_end","next_chapter":"ending/tease"}]}}}